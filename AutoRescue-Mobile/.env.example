# AutoRescue Android - Environment Configuration
# Copy this file to .env and fill in with your actual values
# This file should NEVER contain real secrets

# ===== Backend API =====
# FastAPI Gateway URL (http://localhost:8000 for local dev)
BACKEND_URL=http://your-backend-domain.com:8000

# ===== Google Maps API =====
# Get API key from Google Cloud Console
# Required for service centre navigation
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ===== Supabase (Database & Auth) =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# ===== Firebase (Optional: Analytics, Crash Reporting) =====
# Configured via google-services.json
# Do NOT put API keys here

# ===== App Configuration =====
# App version (should match build.gradle)
APP_VERSION=1.0.0

# API request timeout (milliseconds)
API_TIMEOUT=30000

# Chat API endpoint
CHAT_ENDPOINT=/api/chat
